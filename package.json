{
  "name": "able-backend",
  "version": "1.0.0",
  "description": "Backend del proyecto Able 73",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:pvp": "node --test --test-concurrency=1 test/pvp.socket.integration.test.js test/pvp.presence.integration.test.js test/pvp.ufo-authority.integration.test.js",
    "test:pvp:stress": "node --test test/pvp.presence.stress.test.js",
    "test:pvp:ufo-stress": "node --test test/pvp.ufo-authority.stress.test.js",
    "test:social": "node --test test/nickname.test.js test/nickname-migration.test.js test/auth-nickname.integration.test.js test/privacy.routes.integration.test.js test/clans.routes.integration.test.js test/taunts.routes.integration.test.js test/bounty.service.test.js test/pvp.socket.integration.test.js",
    "nicknames:audit": "node scripts/migrate-nicknames.js",
    "nicknames:migrate": "node scripts/migrate-nicknames.js --apply",
    "test:commercial": "node --test --test-concurrency=1 test/commercial.workflow.test.js test/critical-auth.routes.integration.test.js",
    "commercial:audit": "node scripts/migrate-commercial-workflow.js",
    "commercial:migrate": "node scripts/migrate-commercial-workflow.js --apply"
  },
  "keywords": [
    "able",
    "stepcoins",
    "gamificación",
    "movilidad"
  ],
  "author": "Angel B.",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.0.1",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.1",
    "multer": "^2.0.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1"
  }
}
