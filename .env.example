PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/able73
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your-firebase-project-id
# Elige solo una credencial Admin. No guardes el JSON dentro del repositorio.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\\secure\\able73-firebase-admin.json
# Alternativa para un gestor de secretos: FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Config publica de la aplicacion Firebase Web (no es una clave Admin).
FIREBASE_WEB_API_KEY=replace-with-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_APP_ID=replace-with-web-app-id
FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=pending-payment-integration
PAYPAL_SECRET=pending-payment-integration
