PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/able73
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000
# Numero de proxies de confianza delante de Node (Render normalmente usa 1).
TRUST_PROXY_HOPS=1
# Limites globales conservadores; los endpoints con coste tienen cuotas menores.
API_REQUESTS_PER_15_MINUTES=1500
JSON_BODY_LIMIT=100kb
FORM_BODY_LIMIT=100kb
SOCKET_MAX_PAYLOAD_BYTES=65536
SOCKET_HANDSHAKE_REQUESTS_PER_MINUTE=120
SOCKET_EVENTS_PER_10_SECONDS=300
FIREBASE_PROJECT_ID=able-8a1b8
# Elige solo una credencial Admin. No guardes el JSON dentro del repositorio.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\\secure\\able73-firebase-admin.json
# Alternativa para un gestor de secretos: FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Config publica de la aplicacion Firebase Web (no es una clave Admin).
# Configuracion publica opcional: el backend ya incluye estos valores como
# predeterminados y permite sobrescribirlos si se migra de proyecto Firebase.
FIREBASE_WEB_API_KEY=AIzaSyDcXxMDzYCnCzVBIGSa3Z4sM4i_ZsUX6vI
FIREBASE_WEB_AUTH_DOMAIN=able-8a1b8.firebaseapp.com
FIREBASE_WEB_APP_ID=1:502569781663:web:4aff9c65c4a3e8fd1fd5aa
FIREBASE_MESSAGING_SENDER_ID=502569781663
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=pending-payment-integration
PAYPAL_SECRET=pending-payment-integration
# Open-Meteo: deja ambos vacíos solo para desarrollo no comercial.
# En producción usa una suscripción y guarda la clave únicamente en el backend.
WEATHER_API_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=replace-with-open-meteo-customer-key
# Clave secreta del proxy movil. Solo backend; habilita Directions API y Places API.
GOOGLE_MAPS_MOBILE_SERVICES_API_KEY=
GOOGLE_MAPS_DIRECTIONS_PER_MINUTE=15
GOOGLE_MAPS_DIRECTIONS_PER_DAY=150
GOOGLE_MAPS_AUTOCOMPLETE_PER_MINUTE=90
GOOGLE_MAPS_AUTOCOMPLETE_PER_DAY=1500
GOOGLE_MAPS_DETAILS_PER_MINUTE=20
GOOGLE_MAPS_DETAILS_PER_DAY=300
# Techo antifraude para recompensas de bicicleta validadas mediante GPS.
