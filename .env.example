PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/able73
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000
# URL pública sin barra final, usada para volver desde Stripe Checkout.
APP_BASE_URL=http://localhost:3000
# Suscripciones de locales mediante Stripe Checkout. Nunca expongas estas claves.
STRIPE_SECRET_KEY=rk_test_replace-with-restricted-test-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-signing-secret
# Actívalo solo después de configurar Stripe Tax y el registro fiscal en Stripe.
STRIPE_AUTOMATIC_TAX=false
# Numero de proxies de confianza delante de Node (Render normalmente usa 1).
TRUST_PROXY_HOPS=1
# Limites globales conservadores; los endpoints con coste tienen cuotas menores.
API_REQUESTS_PER_15_MINUTES=1500
JSON_BODY_LIMIT=100kb
FORM_BODY_LIMIT=100kb
SOCKET_MAX_PAYLOAD_BYTES=65536
SOCKET_HANDSHAKE_REQUESTS_PER_MINUTE=120
SOCKET_EVENTS_PER_10_SECONDS=300
FIREBASE_PROJECT_ID=able-8a1b8
# Elige solo una credencial Admin. No guardes el JSON dentro del repositorio.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\\secure\\able73-firebase-admin.json
# Alternativa para un gestor de secretos: FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Config publica de la aplicacion Firebase Web (no es una clave Admin).
# Configuracion publica opcional: el backend ya incluye estos valores como
# predeterminados y permite sobrescribirlos si se migra de proyecto Firebase.
FIREBASE_WEB_API_KEY=AIzaSyDcXxMDzYCnCzVBIGSa3Z4sM4i_ZsUX6vI
FIREBASE_WEB_AUTH_DOMAIN=able-8a1b8.firebaseapp.com
FIREBASE_WEB_APP_ID=1:502569781663:web:4aff9c65c4a3e8fd1fd5aa
FIREBASE_MESSAGING_SENDER_ID=502569781663
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=pending-payment-integration
PAYPAL_SECRET=pending-payment-integration
# Google Play Billing (verificacion server-to-server de compras de Stepcoins).
# El applicationId de la app Android (android/app/build.gradle.kts).
GOOGLE_PLAY_PACKAGE_NAME=com.able73.app
# Cuenta de servicio de Google Cloud con acceso a la Play Developer API
# (Play Console -> Configuracion -> Acceso a la API). No guardes el JSON
# dentro del repositorio.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=C:\\secure\\able73-play-service-account.json
# Alternativa para un gestor de secretos: GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={...}
# App Store / StoreKit 2. El bundle tiene un valor seguro por defecto, pero se
# deja explicito para que el despliegue documente la app que valida.
APPLE_IAP_BUNDLE_ID=com.able73.app
# Apple ID numerico de la app en App Store Connect. Es obligatorio para crear
# el verificador Production; Sandbox/TestFlight funciona aunque aun este vacio.
APPLE_IAP_APP_ID=replace-with-numeric-app-apple-id
# true valida tambien vigencia/revocacion de la cadena mediante Apple (OCSP).
APPLE_IAP_ENABLE_ONLINE_CHECKS=true
# Opcional: lista separada por ':' en Linux o ';' en Windows. Si se omite,
# se usan los certificados oficiales incluidos en api/certificates/apple.
# APPLE_IAP_ROOT_CA_PATHS=/secure/AppleIncRootCertificate.cer:/secure/AppleRootCA-G2.cer:/secure/AppleRootCA-G3.cer
# Open-Meteo: deja ambos vacíos solo para desarrollo no comercial.
# En producción usa una suscripción y guarda la clave únicamente en el backend.
WEATHER_API_BASE_URL=https://customer-api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=replace-with-open-meteo-customer-key
# Techo antifraude para recompensas de bicicleta validadas mediante GPS.
CYCLING_REWARD_PER_HOUR=15000
GROUND_ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=http://127.0.0.1:8002
VALHALLA_TIMEOUT_MS=1500

# Uber Riders / Ride Request API. UBER_CLIENT_SECRET y la clave de cifrado
# existen solo en Render/backend; nunca se compilan dentro de Flutter.
UBER_API_ENV=sandbox
UBER_CLIENT_ID=replace-with-uber-client-id
UBER_CLIENT_SECRET=replace-with-uber-client-secret
UBER_REDIRECT_URI=https://your-render-service.onrender.com/api/uber/oauth/callback
# Genera 32 bytes aleatorios, por ejemplo: openssl rand -base64 32
UBER_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
UBER_HTTP_TIMEOUT_MS=10000
